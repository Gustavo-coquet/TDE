generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Turma {
  id       String   @id @default(uuid())
  nome     String
  criadoEm DateTime @default(now())

  alunos       Aluno[]
  provasMestre ProvaMestre[]
}

model Aluno {
  id                String            @id @default(uuid())
  nome              String
  matricula         String
  turma             Turma             @relation(fields: [turmaId], references: [id])
  turmaId           String
  criadoEm          DateTime          @default(now())
  provasIndividuais ProvaIndividual[]

  @@unique([turmaId, matricula])
}

model Questao {
  id           String   @id @default(uuid())
  tema         String
  dificuldade  Int
  enunciado    String                        // template com placeholders {NOME}
  variaveis    Json                           // [{ nome, min, max, decimais }] — entradas sorteadas
  etapas       Json                           // [{ nome, formula, decimais, unidade, saida }] — em ordem; cada uma pode usar variaveis + etapas anteriores
  imagem       String?                        // imagem opcional (esquema/desenho), guardada como data URL base64
  criadoEm     DateTime @default(now())

  provaMestreQuestoes    ProvaMestreQuestao[]
  provaIndividualQuestoes ProvaIndividualQuestao[]
}

model ProvaMestre {
  id               String   @id @default(uuid())
  titulo           String
  turma            Turma    @relation(fields: [turmaId], references: [id])
  turmaId          String
  valor            Float    @default(10)          // quantos pontos vale o TDE (nota é proporcional a isso)
  prazoFinal       DateTime?                      // até quando o aluno pode responder (null = sem prazo)
  status           String   @default("rascunho") // rascunho | publicada
  criadoEm         DateTime @default(now())

  questoes         ProvaMestreQuestao[]
  provasIndividuais ProvaIndividual[]
}

model ProvaMestreQuestao {
  id            String      @id @default(uuid())
  provaMestre   ProvaMestre @relation(fields: [provaMestreId], references: [id])
  provaMestreId String
  questao       Questao     @relation(fields: [questaoId], references: [id])
  questaoId     String
  ordem         Int

  @@unique([provaMestreId, questaoId])
}

model ProvaIndividual {
  id            String      @id @default(uuid())
  provaMestre   ProvaMestre @relation(fields: [provaMestreId], references: [id])
  provaMestreId String
  aluno         Aluno       @relation(fields: [alunoId], references: [id])
  alunoId       String
  tentativa     Int         @default(1) // 1 ou 2 — o aluno pode tentar de novo, vale a maior nota
  seed          String
  qrToken       String      // matrícula do aluno (igual nas duas tentativas)
  status        String      @default("gerada") // gerada | em_andamento | finalizada
  iniciadaEm    DateTime?
  finalizadaEm  DateTime?
  acertos       Int?
  total         Int?

  questoes      ProvaIndividualQuestao[]

  @@unique([provaMestreId, alunoId, tentativa])
}

model ProvaIndividualQuestao {
  id                    String          @id @default(uuid())
  provaIndividual       ProvaIndividual @relation(fields: [provaIndividualId], references: [id])
  provaIndividualId     String
  questao               Questao         @relation(fields: [questaoId], references: [id])
  questaoId             String
  ordem                 Int
  parametrosGerados     Json
  enunciadoFinal        String
  alternativasFinal     Json            // [{letra, correta, campos:[{nome,unidade,valor}]}]
  respostaCorretaLetra  String
  respostaAlunoLetra    String?
  correta               Boolean?

  @@unique([provaIndividualId, questaoId])
}
